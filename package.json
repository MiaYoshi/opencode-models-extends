{
  "name": "opencode-models-extends",
  "version": "0.0.2",
  "description": "OpenCode plugin: reuse model config across providers via extends references to template files",
  "type": "module",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiaYoshi/opencode-models-extends.git"
  },
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node --input-type=module -e \"await import('./index.ts')\"",
    "verify": "npm run typecheck && npm run test && npm run smoke && npm pack --dry-run"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.14",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
